# Database Service Environment Variables

PORT=3002
DATABASE_URL=postgresql://bahub:bahub_dev@localhost:5432/bahub

# Browser-facing CORS origins, comma-separated. Defaults to the local dev
# frontend + backend origins when unset.
CORS_ORIGINS=

# Admin viewer access: shared secret (must match the backend's
# DB_ADMIN_SECRET) plus extra allowed origins ("null" permits file://).
DB_ADMIN_SECRET=
DB_ADMIN_ORIGINS=
