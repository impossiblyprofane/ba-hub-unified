# Backend Environment Variables

PORT=3001
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
DATABASE_SERVICE_URL=http://localhost:3002
RELOAD_SECRET=

# Hidden /sys admin panel — empty ADMIN_TOKEN disables the /admin/* endpoints.
# DB_ADMIN_SECRET must match the database service's value.
ADMIN_TOKEN=
DB_ADMIN_SECRET=

# External Broken Arrow stats API + match crawler
STATS_API_URL=https://api.brokenarrowgame.tech
STATS_PARTNER_TOKEN=
STATS_COLLECTION_ENABLED=true
STEAM_API_KEY=

# Crawler / metrics tuning (all optional — defaults live in backend/src/index.ts)
CRAWLER_PLAYER_COUNT=
CRAWLER_CHUNK_SIZE=
CRAWLER_BATCH_SIZE=
CRAWLER_BATCH_DELAY_MS=
CRAWLER_INTERVAL_MS=
SLOW_REQUEST_THRESHOLD_MS=

# ── API traffic encryption (optional, surface-level anti-scraping) ──
# When both are set, the GraphQL hooks at backend/src/index.ts decrypt
# incoming `{ e: ciphertext }` envelopes and re-encrypt their responses.
# Plaintext requests still pass through unchanged so GraphiQL keeps working.
# Must match VITE_ENCRYPTION_KEY / VITE_ENCRYPTION_IV in the frontend.
#   ENCRYPTION_KEY = 32 hex chars (256-bit AES key)
#   ENCRYPTION_IV  = 16 hex chars (128-bit IV)
ENCRYPT_API=false
ENCRYPTION_KEY=
ENCRYPTION_IV=
